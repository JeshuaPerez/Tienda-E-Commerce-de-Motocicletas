# Copia este archivo a .env y completa los valores. .env nunca se sube al repositorio.

# Puerto HTTP de la API
PORT=3000

# Base de desarrollo y base de pruebas (el nombre de la de pruebas debe terminar en _test).
# <usuario> es el ROL de PostgreSQL (por ejemplo motostore), no tu usuario de Windows.
# Si la clave tiene @ # / ? % : escríbelos codificados (por ejemplo @ → %40).
DATABASE_URL=postgresql://<usuario>:<clave>@localhost:5432/motostore
DATABASE_URL_TEST=postgresql://<usuario>:<clave>@localhost:5432/motostore_test

# JWT: secreto de al menos 32 caracteres y duración del token (formato de jsonwebtoken, p. ej. 8h)
JWT_SECRET=
JWT_EXPIRA=8h

# Costo de bcrypt (entre 4 y 15; 12 por defecto)
BCRYPT_COSTO=12

# Primer administrador, creado por el seed (npm run db:seed). La contraseña debe tener entre 8 y 72 caracteres.
ADMIN_CORREO=
ADMIN_NOMBRE=
ADMIN_CONTRASENA=

# Opcional: carpeta de comprobantes de transferencia (por defecto backend/uploads/comprobantes, fuera de git)
DIRECTORIO_COMPROBANTES=

# Opcional: factura interna (PA-7). Serie y datos del emisor que se muestran en cada factura
FACTURA_SERIE=A
EMISOR_NOMBRE=MotoStore GT
EMISOR_NIT=
EMISOR_DIRECCION=
