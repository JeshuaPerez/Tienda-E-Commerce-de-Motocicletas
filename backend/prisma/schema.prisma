// Esquema de datos de MotoStore GT. Crece por fases; ver docs/plan.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  CLIENTE
  ADMINISTRADOR
}

// Cuenta de acceso (RF 01). El correo es único y está indexado.
model Usuario {
  id                    Int                        @id @default(autoincrement())
  correo                String                     @unique @db.VarChar(150)
  hashContrasena        String                     @map("hash_contrasena") @db.VarChar(100)
  nombre                String                     @db.VarChar(120)
  rol                   Rol                        @default(CLIENTE)
  activo                Boolean                    @default(true)
  creadoEn              DateTime                   @default(now()) @map("creado_en")
  actualizadoEn         DateTime                   @updatedAt @map("actualizado_en")
  cliente               Cliente?
  movimientos           MovimientoInventario[]
  ordenesCompra         OrdenCompra[]
  recepciones           Recepcion[]
  ventasComoVendedor    Venta[]                    @relation("VendedorVenta")
  cajasAbiertas         SesionCaja[]               @relation("CajaAbiertaPor")
  cajasCerradas         SesionCaja[]               @relation("CajaCerradaPor")
  movimientosCaja       MovimientoCaja[]
  comprobantesRevisados ComprobanteTransferencia[]
  facturasAnuladas      Factura[]

  @@map("usuarios")
}

// Datos comerciales y fiscales de quien compra. En mostrador puede no tener cuenta.
model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(150)
  nit       String?  @db.VarChar(20)
  direccion String?  @db.VarChar(250)
  telefono  String?  @db.VarChar(20)
  usuarioId Int?     @unique @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoEn  DateTime @default(now()) @map("creado_en")
  ventas    Venta[]

  @@index([nit])
  @@map("clientes")
}

// ───────────── Fase 2: catálogo, inventario y compras (RF 02, RF 06, RF 07) ─────────────

enum EstadoMotocicleta {
  DISPONIBLE
  RESERVADA
  VENDIDA
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

enum MotivoMovimiento {
  COMPRA
  ALTA_MANUAL
  AJUSTE
  VENTA_WEB
  VENTA_POS
  LIBERACION
}

enum TipoProveedor {
  LOCAL
  INTERNACIONAL
}

enum EstadoOrdenCompra {
  BORRADOR
  ENVIADA
  RECIBIDA_PARCIAL
  RECIBIDA
  CANCELADA
}

model Marca {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique @db.VarChar(80)
  creadoEn DateTime @default(now()) @map("creado_en")
  modelos  Modelo[]

  @@map("marcas")
}

// El stock mínimo es por modelo: la alerta compara las unidades DISPONIBLES contra este valor (RF 06).
model Modelo {
  id            Int                  @id @default(autoincrement())
  marcaId       Int                  @map("marca_id")
  marca         Marca                @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  nombre        String               @db.VarChar(100)
  cilindrada    Int
  stockMinimo   Int                  @default(0) @map("stock_minimo")
  creadoEn      DateTime             @default(now()) @map("creado_en")
  motocicletas  Motocicleta[]
  detallesOrden OrdenCompraDetalle[]

  @@unique([marcaId, nombre])
  @@index([cilindrada])
  @@map("modelos")
}

// Cada unidad física, identificada por su VIN único e irrepetible (regla de negocio 1).
model Motocicleta {
  id               Int                    @id @default(autoincrement())
  vin              String                 @unique @db.VarChar(17)
  modeloId         Int                    @map("modelo_id")
  modelo           Modelo                 @relation(fields: [modeloId], references: [id], onDelete: Restrict)
  anio             Int
  color            String                 @db.VarChar(40)
  precio           Decimal                @db.Decimal(12, 2)
  costoAdquisicion Decimal?               @map("costo_adquisicion") @db.Decimal(12, 2)
  descripcion      String?
  fichaTecnica     Json?                  @map("ficha_tecnica")
  estado           EstadoMotocicleta      @default(DISPONIBLE)
  recepcionId      Int?                   @map("recepcion_id")
  recepcion        Recepcion?             @relation(fields: [recepcionId], references: [id], onDelete: Restrict)
  creadoEn         DateTime               @default(now()) @map("creado_en")
  actualizadoEn    DateTime               @updatedAt @map("actualizado_en")
  movimientos      MovimientoInventario[]
  lineasVenta      VentaDetalle[]

  @@index([estado])
  @@index([precio])
  @@index([modeloId])
  @@map("motocicletas")
}

// Accesorios (PA-1): sin VIN, con stock por cantidad.
model Accesorio {
  id            Int                    @id @default(autoincrement())
  sku           String                 @unique @db.VarChar(40)
  nombre        String                 @db.VarChar(120)
  descripcion   String?
  precio        Decimal                @db.Decimal(12, 2)
  stock         Int                    @default(0)
  stockMinimo   Int                    @default(0) @map("stock_minimo")
  activo        Boolean                @default(true)
  creadoEn      DateTime               @default(now()) @map("creado_en")
  actualizadoEn DateTime               @updatedAt @map("actualizado_en")
  movimientos   MovimientoInventario[]
  detallesOrden OrdenCompraDetalle[]
  lineasVenta   VentaDetalle[]

  @@map("accesorios")
}

// Bitácora de entradas y salidas (RF 06). Cada movimiento es de una moto o de un accesorio, nunca de ambos.
model MovimientoInventario {
  id            Int              @id @default(autoincrement())
  tipo          TipoMovimiento
  motivo        MotivoMovimiento
  cantidad      Int
  motocicletaId Int?             @map("motocicleta_id")
  motocicleta   Motocicleta?     @relation(fields: [motocicletaId], references: [id], onDelete: Restrict)
  accesorioId   Int?             @map("accesorio_id")
  accesorio     Accesorio?       @relation(fields: [accesorioId], references: [id], onDelete: Restrict)
  referencia    String?          @db.VarChar(200)
  usuarioId     Int              @map("usuario_id")
  usuario       Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  fecha         DateTime         @default(now())

  @@index([fecha])
  @@index([motocicletaId])
  @@index([accesorioId])
  @@map("movimientos_inventario")
}

model Proveedor {
  id       Int           @id @default(autoincrement())
  nombre   String        @db.VarChar(150)
  tipo     TipoProveedor
  nit      String?       @db.VarChar(20)
  pais     String        @db.VarChar(60)
  contacto String?       @db.VarChar(120)
  telefono String?       @db.VarChar(30)
  correo   String?       @db.VarChar(150)
  activo   Boolean       @default(true)
  creadoEn DateTime      @default(now()) @map("creado_en")
  ordenes  OrdenCompra[]

  @@index([nit])
  @@map("proveedores")
}

// Órdenes de compra en GTQ (PA-11).
model OrdenCompra {
  id            Int                  @id @default(autoincrement())
  proveedorId   Int                  @map("proveedor_id")
  proveedor     Proveedor            @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  estado        EstadoOrdenCompra    @default(BORRADOR)
  total         Decimal              @db.Decimal(12, 2)
  notas         String?
  usuarioId     Int                  @map("usuario_id")
  usuario       Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  creadaEn      DateTime             @default(now()) @map("creada_en")
  actualizadaEn DateTime             @updatedAt @map("actualizada_en")
  detalles      OrdenCompraDetalle[]
  recepciones   Recepcion[]

  @@index([estado])
  @@map("ordenes_compra")
}

// Cada línea pide un modelo de moto o un accesorio, nunca ambos.
model OrdenCompraDetalle {
  id               Int         @id @default(autoincrement())
  ordenCompraId    Int         @map("orden_compra_id")
  ordenCompra      OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  modeloId         Int?        @map("modelo_id")
  modelo           Modelo?     @relation(fields: [modeloId], references: [id], onDelete: Restrict)
  accesorioId      Int?        @map("accesorio_id")
  accesorio        Accesorio?  @relation(fields: [accesorioId], references: [id], onDelete: Restrict)
  cantidad         Int
  cantidadRecibida Int         @default(0) @map("cantidad_recibida")
  costoUnitario    Decimal     @map("costo_unitario") @db.Decimal(12, 2)

  @@index([ordenCompraId])
  @@map("ordenes_compra_detalle")
}

// Recepción de mercancía: crea las motos con su VIN y suma el stock de accesorios.
model Recepcion {
  id            Int           @id @default(autoincrement())
  ordenCompraId Int           @map("orden_compra_id")
  ordenCompra   OrdenCompra   @relation(fields: [ordenCompraId], references: [id], onDelete: Restrict)
  usuarioId     Int           @map("usuario_id")
  usuario       Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  notas         String?
  fecha         DateTime      @default(now())
  motocicletas  Motocicleta[]

  @@index([ordenCompraId])
  @@map("recepciones")
}

// ───────────── Fase 3: ventas, cupones y caja (RF 03, RF 04, RF 05, RF 09) ─────────────

enum CanalVenta {
  WEB
  POS
}

// PENDIENTE_PAGO → (comprobante) PENDIENTE_VALIDACION → PAGADA → ENTREGADA. RECHAZADA y CANCELADA liberan las unidades.
enum EstadoVenta {
  PENDIENTE_PAGO
  PENDIENTE_VALIDACION
  PAGADA
  ENTREGADA
  RECHAZADA
  CANCELADA
}

// TRANSFERENCIA y POS_AL_RETIRAR son de la tienda web; EFECTIVO, TARJETA y TRANSFERENCIA, del mostrador (PA-5).
enum MetodoPago {
  TRANSFERENCIA
  POS_AL_RETIRAR
  EFECTIVO
  TARJETA
}

enum TipoCupon {
  PORCENTAJE
  MONTO_FIJO
}

enum CanalCupon {
  WEB
  POS
  AMBOS
}

enum EstadoComprobante {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum TipoMovimientoCaja {
  INGRESO
  RETIRO
}

enum MedioCaja {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

model Cupon {
  id           Int        @id @default(autoincrement())
  codigo       String     @unique @db.VarChar(40)
  tipo         TipoCupon
  valor        Decimal    @db.Decimal(12, 2)
  vigenteDesde DateTime   @map("vigente_desde")
  vigenteHasta DateTime   @map("vigente_hasta")
  usosMaximos  Int?       @map("usos_maximos")
  usosActuales Int        @default(0) @map("usos_actuales")
  canal        CanalCupon @default(AMBOS)
  activo       Boolean    @default(true)
  creadoEn     DateTime   @default(now()) @map("creado_en")
  ventas       Venta[]

  @@map("cupones")
}

// Venta única para web y mostrador (canal). Montos en GTQ; el IVA va incluido en el total (PA-6).
model Venta {
  id               Int                        @id @default(autoincrement())
  canal            CanalVenta
  estado           EstadoVenta
  metodoPago       MetodoPago                 @map("metodo_pago")
  referenciaPago   String?                    @map("referencia_pago") @db.VarChar(100)
  clienteId        Int                        @map("cliente_id")
  cliente          Cliente                    @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vendedorId       Int?                       @map("vendedor_id")
  vendedor         Usuario?                   @relation("VendedorVenta", fields: [vendedorId], references: [id], onDelete: Restrict)
  cuponId          Int?                       @map("cupon_id")
  cupon            Cupon?                     @relation(fields: [cuponId], references: [id], onDelete: Restrict)
  sesionCajaId     Int?                       @map("sesion_caja_id")
  sesionCaja       SesionCaja?                @relation(fields: [sesionCajaId], references: [id], onDelete: Restrict)
  subtotal         Decimal                    @db.Decimal(12, 2)
  descuento        Decimal                    @default(0) @db.Decimal(12, 2)
  total            Decimal                    @db.Decimal(12, 2)
  iva              Decimal                    @db.Decimal(12, 2)
  nitFactura       String                     @default("CF") @map("nit_factura") @db.VarChar(20)
  nombreFactura    String                     @map("nombre_factura") @db.VarChar(150)
  direccionFactura String                     @default("Ciudad") @map("direccion_factura") @db.VarChar(250)
  creadaEn         DateTime                   @default(now()) @map("creada_en")
  actualizadaEn    DateTime                   @updatedAt @map("actualizada_en")
  pagadaEn         DateTime?                  @map("pagada_en")
  entregadaEn      DateTime?                  @map("entregada_en")
  detalles         VentaDetalle[]
  comprobantes     ComprobanteTransferencia[]
  facturas         Factura[]
  movimientosCaja  MovimientoCaja[]

  @@index([estado])
  @@index([creadaEn])
  @@index([clienteId])
  @@index([nitFactura])
  @@map("ventas")
}

// Cada línea es una moto (cantidad 1) o un accesorio, nunca ambos.
model VentaDetalle {
  id             Int          @id @default(autoincrement())
  ventaId        Int          @map("venta_id")
  venta          Venta        @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  motocicletaId  Int?         @map("motocicleta_id")
  motocicleta    Motocicleta? @relation(fields: [motocicletaId], references: [id], onDelete: Restrict)
  accesorioId    Int?         @map("accesorio_id")
  accesorio      Accesorio?   @relation(fields: [accesorioId], references: [id], onDelete: Restrict)
  descripcion    String       @db.VarChar(200)
  cantidad       Int
  precioUnitario Decimal      @map("precio_unitario") @db.Decimal(12, 2)
  subtotal       Decimal      @db.Decimal(12, 2)

  @@index([ventaId])
  @@index([motocicletaId])
  @@map("ventas_detalle")
}

// Comprobante de transferencia subido por el cliente (PA-8). El archivo vive fuera de git.
model ComprobanteTransferencia {
  id            Int               @id @default(autoincrement())
  ventaId       Int               @map("venta_id")
  venta         Venta             @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  rutaArchivo   String            @map("ruta_archivo") @db.VarChar(200)
  tipoArchivo   String            @map("tipo_archivo") @db.VarChar(50)
  tamano        Int
  estado        EstadoComprobante @default(PENDIENTE)
  motivoRechazo String?           @map("motivo_rechazo") @db.VarChar(300)
  revisadoPorId Int?              @map("revisado_por_id")
  revisadoPor   Usuario?          @relation(fields: [revisadoPorId], references: [id], onDelete: Restrict)
  revisadoEn    DateTime?         @map("revisado_en")
  subidoEn      DateTime          @default(now()) @map("subido_en")

  @@index([estado])
  @@index([ventaId])
  @@map("comprobantes_transferencia")
}

// Caja diaria (RF 05). Solo puede haber una ABIERTA a la vez (índice único parcial en la migración).
model SesionCaja {
  id                  Int              @id @default(autoincrement())
  estado              EstadoCaja       @default(ABIERTA)
  abiertaPorId        Int              @map("abierta_por_id")
  abiertaPor          Usuario          @relation("CajaAbiertaPor", fields: [abiertaPorId], references: [id], onDelete: Restrict)
  abiertaEn           DateTime         @default(now()) @map("abierta_en")
  fechaOperacion      String           @map("fecha_operacion") @db.VarChar(10)
  montoInicial        Decimal          @map("monto_inicial") @db.Decimal(12, 2)
  cerradaPorId        Int?             @map("cerrada_por_id")
  cerradaPor          Usuario?         @relation("CajaCerradaPor", fields: [cerradaPorId], references: [id], onDelete: Restrict)
  cerradaEn           DateTime?        @map("cerrada_en")
  efectivoEsperado    Decimal?         @map("efectivo_esperado") @db.Decimal(12, 2)
  efectivoContado     Decimal?         @map("efectivo_contado") @db.Decimal(12, 2)
  vouchersEsperado    Decimal?         @map("vouchers_esperado") @db.Decimal(12, 2)
  vouchersContado     Decimal?         @map("vouchers_contado") @db.Decimal(12, 2)
  transferenciasTotal Decimal?         @map("transferencias_total") @db.Decimal(12, 2)
  notasCierre         String?          @map("notas_cierre") @db.VarChar(500)
  movimientos         MovimientoCaja[]
  ventas              Venta[]

  @@index([fechaOperacion])
  @@map("sesiones_caja")
}

model MovimientoCaja {
  id           Int                @id @default(autoincrement())
  sesionCajaId Int                @map("sesion_caja_id")
  sesionCaja   SesionCaja         @relation(fields: [sesionCajaId], references: [id], onDelete: Restrict)
  tipo         TipoMovimientoCaja
  medio        MedioCaja
  monto        Decimal            @db.Decimal(12, 2)
  concepto     String             @db.VarChar(200)
  referencia   String?            @db.VarChar(100)
  ventaId      Int?               @map("venta_id")
  venta        Venta?             @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  usuarioId    Int                @map("usuario_id")
  usuario      Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  fecha        DateTime           @default(now())

  @@index([sesionCajaId])
  @@index([fecha])
  @@map("movimientos_caja")
}

// ───────────── Fase 4: facturación (RF 08) ─────────────

enum EstadoFactura {
  EMITIDA
  ANULADA
}

// Correlativo por serie. Se incrementa con un solo UPDATE atómico dentro de la transacción de la venta.
model SerieFactura {
  serie        String @id @db.VarChar(10)
  ultimoNumero Int    @default(0) @map("ultimo_numero")

  @@map("series_factura")
}

// Factura interna (PA-7): no es FEL. Guarda una copia fija de los datos fiscales y de los montos al emitirse.
// Una venta puede tener facturas anuladas, pero solo una EMITIDA (índice único parcial en la migración).
model Factura {
  id              Int            @id @default(autoincrement())
  serie           String         @db.VarChar(10)
  numero          Int
  ventaId         Int            @map("venta_id")
  venta           Venta          @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  nit             String         @db.VarChar(20)
  nombre          String         @db.VarChar(150)
  direccion       String         @db.VarChar(250)
  subtotal        Decimal        @db.Decimal(12, 2)
  descuento       Decimal        @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  baseImponible   Decimal        @map("base_imponible") @db.Decimal(12, 2)
  iva             Decimal        @db.Decimal(12, 2)
  estado          EstadoFactura  @default(EMITIDA)
  emitidaEn       DateTime       @default(now()) @map("emitida_en")
  anuladaEn       DateTime?      @map("anulada_en")
  anuladaPorId    Int?           @map("anulada_por_id")
  anuladaPor      Usuario?       @relation(fields: [anuladaPorId], references: [id], onDelete: Restrict)
  motivoAnulacion String?        @map("motivo_anulacion") @db.VarChar(300)
  lineas          FacturaLinea[]

  @@unique([serie, numero])
  @@index([nit])
  @@index([ventaId])
  @@index([emitidaEn])
  @@map("facturas")
}

model FacturaLinea {
  id             Int     @id @default(autoincrement())
  facturaId      Int     @map("factura_id")
  factura        Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  descripcion    String  @db.VarChar(200)
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  @@index([facturaId])
  @@map("facturas_lineas")
}
