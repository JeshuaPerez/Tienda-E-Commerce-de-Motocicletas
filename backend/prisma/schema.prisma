// Esquema de datos de MotoStore GT. Crece por fases; ver docs/plan.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  CLIENTE
  ADMINISTRADOR
}

// Cuenta de acceso (RF 01). El correo es único y está indexado.
model Usuario {
  id             Int      @id @default(autoincrement())
  correo         String   @unique @db.VarChar(150)
  hashContrasena String   @map("hash_contrasena") @db.VarChar(100)
  nombre         String   @db.VarChar(120)
  rol            Rol      @default(CLIENTE)
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en")
  cliente        Cliente?

  @@map("usuarios")
}

// Datos comerciales y fiscales de quien compra. En mostrador puede no tener cuenta.
model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(150)
  nit       String?  @db.VarChar(20)
  direccion String?  @db.VarChar(250)
  telefono  String?  @db.VarChar(20)
  usuarioId Int?     @unique @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@index([nit])
  @@map("clientes")
}
